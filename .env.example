# 버셀(Vercel) Environment Variables 에 넣을 항목 목록 (값은 비워둔 예시)
ANTHROPIC_API_KEY=
ADMIN_PASSWORD=
SESSION_SECRET=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=low
# 대화기록·수정한 Q&A/규칙을 GitHub 의 chatbot-data 브랜치에 저장할 때 쓰는 열쇠 (Contents: Read and write)
GITHUB_TOKEN=
# (선택) 데이터를 다른 저장소에 두고 싶을 때만: owner/name
GITHUB_DATA_REPO=
